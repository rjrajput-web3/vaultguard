# VAULTGUARD contract deploy env — TESTNET ONLY. Never commit real values.
# This file is an example; copy to .env (gitignored) and fill in.
#
# ONE-TIME SETUP (his step, on his own device):
#   1. Create a free testnet wallet at https://wallet.testnet.near.org
#      (it comes with testnet NEAR; no real money involved).
#   2. In the wallet, export the account's private key (ed25519:... format).
#   3. Paste below. Nothing here ever touches mainnet.

# Testnet account that pays for the deploy, e.g. xyzcryp0.testnet
NEAR_DEPLOYER_ACCOUNT=

# Private key of the deployer account (ed25519:... base58). NEVER commit.
NEAR_DEPLOYER_KEY=

# Optional overrides (sane defaults below)
# VAULT_SUBACCOUNT=vaultguard.xyzcryp0.testnet
# GUARDIAN_ACCOUNT=xyzcryp0.testnet
# MAX_SPEND_PER_TX_USDC=1000
